datasource db {
  provider = "sqlite"
  url      = "file:./qa-test.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String            @id @default(uuid())
  email        String            @unique
  passwordHash String
  name         String
  avatarUrl    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  memberships  HouseholdMember[]
  transactions Transaction[]
  accounts     Account[]
  employments  EmploymentProfile[]
  payslips     PayslipRecord[]
}

model Household {
  id                    String                 @id @default(uuid())
  name                  String
  currency              String                 @default("INR")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  members               HouseholdMember[]
  accounts              Account[]
  categories            Category[]
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  budgets               Budget[]
  goals                 Goal[]
  investments           Investment[]
  assets                Asset[]
  liabilities           Liability[]
  forecastScenarios     ForecastScenario[]
  incomeSources         IncomeSource[]
  incomeOccurrences     IncomeOccurrence[]
  recurringOccurrences  RecurringBillOccurrence[]
  invitations           HouseholdInvitation[]
  employments           EmploymentProfile[]
  payslips              PayslipRecord[]
}

model HouseholdMember {
  id          String    @id @default(uuid())
  householdId String
  userId      String
  role        String    @default("MEMBER") // OWNER, MEMBER, VIEWER
  createdAt   DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
}

model Account {
  id              String        @id @default(uuid())
  householdId     String
  userId          String?
  name            String
  type            String        @default("BANK") // BANK, CREDIT, CASH, INVESTMENT, LOAN
  balance         Decimal       @default(0.00)
  accountNumber   String?
  currency        String        @default("INR")
  isShared        Boolean       @default(true)
  creditLimit     Decimal?
  billingCycleDay Int?
  paymentDueDate  Int?
  interestRate    Decimal?
  maturityDate    DateTime?
  principalAmount Decimal?
  isArchived      Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  household     Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userHolder    User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  transactions  Transaction[]          @relation("AccountTransactions")
  transfersIn   Transaction[]          @relation("TransferAccountTransactions")
  recurring     RecurringTransaction[]
  investments   Investment[]
  incomeSources IncomeSource[]
  payslips      PayslipRecord[]
}

model Category {
  id            String        @id @default(uuid())
  householdId   String
  parentId      String?
  name          String
  icon          String        @default("tag")
  color         String        @default("#64748b")
  type          String        @default("EXPENSE") // INCOME, EXPENSE, TRANSFER
  isDefault     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  household     Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  parent        Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subcategories Category[]    @relation("CategoryHierarchy")
  transactions  Transaction[]
  recurring     RecurringTransaction[]
  budgets       Budget[]
  incomeSources IncomeSource[]
}

model Transaction {
  id                String    @id @default(uuid())
  householdId       String
  accountId         String
  categoryId        String?
  userId            String?
  date              DateTime  @default(now())
  amount            Decimal
  type              String    @default("EXPENSE") // INCOME, EXPENSE, TRANSFER
  transferAccountId String?
  incomeSourceId        String?
  occurrenceId          String?
  paymentMethod         String?
  referenceNo           String?
  idempotencyKey       String?   @unique
  merchant              String?
  receiptUrl            String?
  recurringRuleId       String?
  recurringOccurrenceId String?
  isRecurring           Boolean   @default(false)
  description           String
  notes                 String?
  tags                  String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  household           Household                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account             Account                  @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  transferAccount     Account?                 @relation("TransferAccountTransactions", fields: [transferAccountId], references: [id], onDelete: SetNull)
  category            Category?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  user                User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  incomeSource        IncomeSource?            @relation(fields: [incomeSourceId], references: [id], onDelete: SetNull)
  occurrence          IncomeOccurrence?        @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)
  recurringRule       RecurringTransaction?    @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  recurringOccurrence RecurringBillOccurrence? @relation(fields: [recurringOccurrenceId], references: [id], onDelete: SetNull)
  payslips            PayslipRecord[]
}

model RecurringTransaction {
  id          String    @id @default(uuid())
  householdId String
  accountId   String
  categoryId  String?
  name        String
  amount      Decimal
  type        String    @default("EXPENSE") // EXPENSE, INCOME, TRANSFER
  frequency   String    @default("MONTHLY") // DAILY, WEEKLY, MONTHLY, YEARLY
  startDate   DateTime  @default(now())
  endDate     DateTime?
  nextDueDate DateTime  @default(now())
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  household   Household                 @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account     Account                   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category    Category?                 @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  occurrences RecurringBillOccurrence[]
  transactions Transaction[]
}

model Budget {
  id          String    @id @default(uuid())
  householdId String
  categoryId  String?
  month       Int
  year        Int
  amount      Decimal
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([householdId, categoryId, month, year])
}

model Goal {
  id            String   @id @default(uuid())
  householdId   String
  name          String
  description   String?
  targetAmount  Decimal
  currentAmount Decimal  @default(0.00)
  targetDate    DateTime
  category      String?
  priority      String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model Investment {
  id            String   @id @default(uuid())
  householdId   String
  accountId     String?
  name          String
  symbol        String?
  type          String   @default("MUTUAL_FUND") // STOCK, MUTUAL_FUND, FIXED_DEPOSIT, GOLD, EPF_PPF, OTHER
  quantity      Decimal  @default(1.0000)
  purchasePrice Decimal
  currentPrice  Decimal
  lastUpdated   DateTime @default(now())
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account   Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)
}

model Asset {
  id           String    @id @default(uuid())
  householdId  String
  name         String
  type         String    @default("OTHER") // REAL_ESTATE, VEHICLE, GOLD, JEWELRY, ELECTRONICS, OTHER
  value        Decimal
  purchaseDate DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model Liability {
  id             String    @id @default(uuid())
  householdId    String
  name           String
  type           String    @default("OTHER") // MORTGAGE, PERSONAL_LOAN, CAR_LOAN, EDUCATION_LOAN, CREDIT_CARD_DEBT, OTHER
  amount         Decimal
  interestRate   Decimal?
  monthlyPayment Decimal?
  dueDate        DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model ForecastScenario {
  id                     String              @id @default(uuid())
  householdId            String
  name                   String              @default("Baseline 2026-2050")
  isDefault              Boolean             @default(true)
  startYear              Int                 @default(2026)
  endYear                Int                 @default(2050)
  inflationRate          Decimal             @default(6.00)
  salaryGrowthRate       Decimal             @default(8.00)
  investmentReturnRate   Decimal             @default(11.00)
  retirementAge          Int                 @default(60)
  baselineMonthlySavings Decimal             @default(50000.00)
  notes                  String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  household              Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  milestones             ForecastMilestone[]
}

model ForecastMilestone {
  id            String           @id @default(uuid())
  scenarioId    String
  name          String
  targetYear    Int
  estimatedCost Decimal
  type          String           @default("EXPENSE")
  createdAt     DateTime         @default(now())
  scenario      ForecastScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
}

model IncomeSource {
  id               String             @id @default(uuid())
  householdId      String
  name             String
  category         String             @default("Other") // Salary, Business, Agriculture, Sericulture, Livestock/Goat Farming, Rental, Freelance/Consulting, Interest/Dividends, Other
  categoryId       String?
  description      String?
  defaultAccountId String?
  expectedAmount   Decimal?
  currency         String             @default("INR")
  behavior         String             @default("RECURRING") // RECURRING, SEASONAL, IRREGULAR, ONE_TIME
  frequency        String?            @default("MONTHLY") // WEEKLY, MONTHLY, QUARTERLY, YEARLY, CUSTOM_SEASONAL
  expectedDay      Int?               @default(1)
  startDate        DateTime?
  endDate          DateTime?
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  household      Household           @relation(fields: [householdId], references: [id], onDelete: Cascade)
  defaultAccount Account?             @relation(fields: [defaultAccountId], references: [id], onDelete: SetNull)
  categoryRef    Category?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  occurrences    IncomeOccurrence[]
  transactions   Transaction[]
  employments    EmploymentProfile[]
}

model IncomeOccurrence {
  id                String        @id @default(uuid())
  householdId       String
  incomeSourceId    String
  name              String
  periodStart       DateTime
  periodEnd         DateTime
  dueDate           DateTime
  expectedAmount    Decimal
  receivedAmount    Decimal       @default(0.00)
  outstandingAmount Decimal
  status            String        @default("PENDING") // PENDING, PARTIALLY_RECEIVED, FULLY_RECEIVED, SKIPPED
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  incomeSource IncomeSource  @relation(fields: [incomeSourceId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model RecurringBillOccurrence {
  id                String               @id @default(uuid())
  householdId       String
  recurringRuleId   String
  name              String
  dueDate           DateTime
  expectedAmount    Decimal
  paidAmount        Decimal              @default(0.00)
  outstandingAmount Decimal
  status            String               @default("UPCOMING") // UPCOMING, DUE, OVERDUE, PARTIALLY_PAID, PAID, SKIPPED
  notes             String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  household     Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  recurringRule RecurringTransaction @relation(fields: [recurringRuleId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@unique([recurringRuleId, dueDate])
}

model HouseholdInvitation {
  id          String   @id @default(uuid())
  householdId String
  email       String
  role        String   @default("MEMBER")
  code        String   @unique
  status      String   @default("PENDING") // PENDING, ACCEPTED, EXPIRED, REVOKED
  expiresAt   DateTime @default(now())
  createdAt   DateTime @default(now())

  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
}

model EmploymentProfile {
  id               String          @id @default(uuid())
  householdId      String
  userId           String
  employerName     String
  designation      String?
  employmentType   String          @default("FULL_TIME") // FULL_TIME, CONTRACT, PART_TIME
  joiningDate      DateTime?
  salaryFrequency  String          @default("MONTHLY")
  salaryCreditDate Int?            @default(1)
  status           String          @default("ACTIVE") // ACTIVE, RESIGNED, ON_LEAVE
  incomeSourceId   String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  household    Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomeSource IncomeSource?   @relation(fields: [incomeSourceId], references: [id], onDelete: SetNull)
  payslips     PayslipRecord[]
}

model PayslipRecord {
  id                   String            @id @default(uuid())
  householdId          String
  employmentId         String
  userId               String
  month                Int
  year                 Int
  payPeriod            String
  // Earnings
  basicSalary          Decimal           @default(0.00)
  hra                  Decimal           @default(0.00)
  otherAllowances      Decimal           @default(0.00)
  bonusIncentives      Decimal           @default(0.00)
  overtimeArrears      Decimal           @default(0.00)
  grossSalary          Decimal           @default(0.00)
  // Deductions
  pfDeduction          Decimal           @default(0.00)
  esiDeduction         Decimal           @default(0.00)
  professionalTax      Decimal           @default(0.00)
  tdsTax               Decimal           @default(0.00)
  otherDeductions      Decimal           @default(0.00)
  totalDeductions      Decimal           @default(0.00)
  // Net Salary & Credit Verification
  netSalary            Decimal           @default(0.00)
  actualCreditDate     DateTime?
  actualAmountCredited Decimal?          @default(0.00)
  accountId            String?
  transactionRef       String?
  status               String            @default("GENERATED") // GENERATED, CONFIRMED_CREDITED, PARTIALLY_CREDITED, DELAYED
  transactionId        String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  household   Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  employment  EmploymentProfile @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account?          @relation(fields: [accountId], references: [id], onDelete: SetNull)
  transaction Transaction?      @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([employmentId, month, year])
}
