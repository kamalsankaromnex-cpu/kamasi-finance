  updatedAt         DateTime               @updatedAt

  household         Household              @relation(fields: [householdId], references: [id], onDelete: Cascade)
  borrowing         Borrowing              @relation(fields: [borrowingId], references: [id], onDelete: Cascade)
  installments      RepaymentInstallment[]

  @@index([borrowingId])
  @@index([householdId])
}

model RepaymentInstallment {
  id                String            @id @default(uuid())
  householdId       String
  borrowingId       String
  scheduleId        String?
  installmentNumber Int
  dueDate           DateTime
  principalAmount   Decimal           @default(0.00)
  interestAmount    Decimal           @default(0.00)
  totalAmount       Decimal           @default(0.00)
  paidPrincipal     Decimal           @default(0.00)
  paidInterest      Decimal           @default(0.00)
  paidAmount        Decimal           @default(0.00)
  remainingAmount   Decimal           @default(0.00)
  status            String            @default("UPCOMING") // UPCOMING, DUE, PARTIALLY_PAID, PAID, OVERDUE, WAIVED, CANCELLED
  paidAt            DateTime?
  notes             String?
