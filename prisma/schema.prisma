  householdId            String
  version                Int       @default(1)
  name                   String    @default("Standard Assumption Set")
  effectiveFrom          DateTime  @default(now())
  effectiveTo            DateTime?
  fixedIncomeLow         Decimal   @default(5.00) // % annual return
  fixedIncomeBase        Decimal   @default(6.50)
  fixedIncomeHigh        Decimal   @default(7.50)
  investmentLow          Decimal   @default(7.00)
  investmentBase         Decimal   @default(11.00)
  investmentHigh         Decimal   @default(14.00)
  emergencyReserveMonths Int       @default(6) // Months of essential expenses
  maxDebtServiceRatio    Decimal   @default(0.35) // Max 35% of monthly surplus towards EMI
