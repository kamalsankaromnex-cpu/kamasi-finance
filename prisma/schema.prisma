  updatedAt         DateTime @updatedAt
}

model Lender {
  id          String      @id @default(uuid())
  householdId String
  name        String
  type        String      @default("BANK") // BANK, NBFC, FAMILY, FRIEND, PRIVATE_LENDER, EMPLOYER, OTHER
  contactInfo String?
  notes       String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  household   Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  borrowings  Borrowing[]

  @@unique([householdId, name])
  @@index([householdId])
}

model Borrowing {
  id                    String                      @id @default(uuid())
  householdId           String
  lenderId              String?
  scopeId               String?
  categoryId            String?
  subcategoryId         String?
  costCenterId          String?
  assetId               String?
  liabilityAccountId    String?
  receivingAccountId    String?
  disbursementJournalId String?
  liabilityId           String?                     @unique

  name                  String
  description           String?
  borrowingType         String                      @default("TERM_LOAN") // TERM_LOAN, EMI_LOAN, LINE_OF_CREDIT, MORTGAGE, VEHICLE_LOAN, PERSONAL_LOAN, BUSINESS_LOAN, PEER_BORROWING, OTHER
  financingType         String                      @default("SECURED") // SECURED, UNSECURED
  repaymentMethod       String                      @default("AMORTIZED_EMI") // AMORTIZED_EMI, BULLET, INTEREST_ONLY, FLEXIBLE, BALLOON
  purpose               String?
  principalAmount       Decimal                     @default(0.00)
  interestRate          Decimal                     @default(0.00) // Annual percentage rate
  tenureMonths          Int?                        @default(12)
  outstandingPrincipal  Decimal                     @default(0.00)
  totalPrincipalPaid    Decimal                     @default(0.00)
  totalInterestPaid     Decimal                     @default(0.00)
  startDate             DateTime?
  maturityDate          DateTime?
  firstPaymentDate      DateTime?
  status                String                      @default("DRAFT") // DRAFT, ACTIVE, PARTIALLY_SETTLED, SETTLED, CANCELLED, ARCHIVED
  archivedAt            DateTime?
  archivedByUserId      String?
  profileId             String?
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt

  household             Household                   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  profile               FamilyProfile?              @relation(fields: [profileId], references: [id], onDelete: SetNull)
  lender                Lender?                     @relation(fields: [lenderId], references: [id], onDelete: SetNull)
  scope                 FinancialScope?             @relation(fields: [scopeId], references: [id], onDelete: SetNull)
  category              Category?                   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory           CategorySubcategory?        @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  costCenter            CostCenter?                 @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  asset                 Asset?                      @relation(fields: [assetId], references: [id], onDelete: SetNull)
  liabilityAccount      Account?                    @relation("BorrowingLiabilityAccount", fields: [liabilityAccountId], references: [id], onDelete: SetNull)
  receivingAccount      Account?                    @relation("BorrowingReceivingAccount", fields: [receivingAccountId], references: [id], onDelete: SetNull)
  disbursementJournal   Journal?                    @relation("BorrowingDisbursementJournal", fields: [disbursementJournalId], references: [id], onDelete: SetNull)
  legacyLiability       Liability?                  @relation(fields: [liabilityId], references: [id], onDelete: SetNull)

  schedules             RepaymentSchedule[]
  installments          RepaymentInstallment[]
  financialEvents       BorrowingFinancialEvent[]
  lifecycleHistory      BorrowingLifecycleHistory[]

  @@index([householdId])
  @@index([householdId, status])
  @@index([lenderId])
  @@index([scopeId])
}

model RepaymentSchedule {
