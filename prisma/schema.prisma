  totalCost               Decimal   @default(0.00)
  riskScore               Float     @default(0.0)
  liquidityScore          Float     @default(100.0)
  flexibilityScore        Float     @default(100.0)
  projectedLow            Decimal   @default(0.00)
  projectedBase           Decimal   @default(0.00)
  projectedHigh           Decimal   @default(0.00)
  fundingGap              Decimal   @default(0.00)
  projectedCompletionDate DateTime?
  planDetailsJson         String    // Strict schema PlanDetails JSON
  snapshotJson            String    // Strict schema FinancialSnapshot JSON
  reasonCodes             String    // JSON array of reason codes
  assumptionSetVersion    Int       @default(1)
  rankingModelVersion     Int       @default(1)
  rankingWeightsJson      String?   // JSON object of weights used
  calculationDate         DateTime  @default(now())
  approvedAt              DateTime?
  approvedByUserId        String?
  supersededAt            DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  household               Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  goal                    Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  parentPlan              GoalFundingPlan? @relation("PlanVersions", fields: [parentPlanId], references: [id], onDelete: SetNull)
  childPlans              GoalFundingPlan[] @relation("PlanVersions")
  history                 GoalFundingPlanLifecycleHistory[]

  @@unique([goalId, version])
  @@index([householdId, goalId, status])
}

model GoalFundingPlanLifecycleHistory {
  id          String   @id @default(uuid())
  planId      String
  householdId String
  fromStatus  String
  toStatus    String
  action      String   // CREATE, PROPOSE, APPROVE, ACTIVATE, REVIEW_REQUIRED, SUPERSEDE, COMPLETE, CANCEL
  reason      String?
  performedBy String?
  metadataJson String?
  createdAt   DateTime @default(now())

  plan        GoalFundingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([householdId])
}

// =========================================================================
// UNIVERSAL PROJECT & FINANCIAL PLANNING ENGINE v2
// =========================================================================

model Project {
  id               String    @id @default(uuid())
  householdId      String
  name             String
  description      String?
  notes            String?
  projectType      String    @default("PERSONAL") // PERSONAL, FAMILY, MARRIAGE, HOME, PROPERTY, AGRICULTURE, LIVESTOCK, BUSINESS, EQUIPMENT, EDUCATION, VEHICLE, OTHER
  status           String    @default("DRAFT")    // DRAFT, PLANNED, ACTIVE, ON_HOLD, COMPLETED, CANCELLED, ARCHIVED
  priority         String    @default("MEDIUM")   // LOW, MEDIUM, HIGH, URGENT
  startDate        DateTime?
  targetDate       DateTime?
  completedAt      DateTime?
  ownerMemberId    String?
  primaryGoalId    String?
  profileId        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  version          Int       @default(1)

  household        Household                   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  profile          FamilyProfile?              @relation(fields: [profileId], references: [id], onDelete: SetNull)
  primaryGoal      Goal?                       @relation(fields: [primaryGoalId], references: [id], onDelete: SetNull)
  financialPlans   ProjectFinancialPlan[]
  costItems        ProjectCostItem[]
  payments         ProjectPaymentRequirement[]
  fundingSources   ProjectFundingSource[]
  tasks            ProjectTask[]
  milestones       ProjectMilestone[]
  lifecycleHistory ProjectLifecycleHistory[]

  @@index([householdId])
  @@index([householdId, status])
  @@index([primaryGoalId])
}

model ProjectFinancialPlan {
  id                 String    @id @default(uuid())
  projectId          String
  householdId        String
  version            Int       @default(1)
  estimatedTotalCost Decimal   @default(0.00)
  planningStatus     String    @default("ACTIVE") // ACTIVE, SUPERSEDED, CANCELLED
  notes              String?
  reason             String?
  createdByUserId    String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@index([projectId, planningStatus])
  @@index([householdId])
}

model ProjectCostItem {
  id            String                      @id @default(uuid())
  projectId     String
  householdId   String
  name          String
  description   String?
  plannedAmount Decimal                     @default(0.00)
  dueDate       DateTime?
  categoryId    String?
  priority      String                      @default("MEDIUM") // LOW, MEDIUM, HIGH
  status        String                      @default("PLANNED") // PLANNED, COMMITTED, COMPLETED, CANCELLED
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  project       Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category      Category?                   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  payments      ProjectPaymentRequirement[]

  @@index([projectId])
  @@index([householdId])
  @@index([categoryId])
}

model ProjectPaymentRequirement {
  id              String                     @id @default(uuid())
  projectId       String
  householdId     String
  costItemId      String?
  name            String
  dueDate         DateTime?
  plannedAmount   Decimal                    @default(0.00)
  committedAmount Decimal                    @default(0.00)
  paidAmount      Decimal                    @default(0.00)
  status          String                     @default("PLANNED") // PLANNED, COMMITTED, PARTIALLY_PAID, PAID, OVERDUE, CANCELLED
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  project         Project                    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  costItem        ProjectCostItem?           @relation(fields: [costItemId], references: [id], onDelete: SetNull)
  allocations     ProjectPaymentAllocation[]

  @@index([projectId])
  @@index([householdId])
  @@index([status])
}

model ProjectFundingSource {
  id                 String    @id @default(uuid())
  projectId          String
  householdId        String
  sourceType         String    @default("OWN_CASH") // OWN_CASH, INCOME, INVESTMENT, ASSET_SALE, BORROWING, OTHER
  name               String
  plannedAmount      Decimal   @default(0.00)
  committedAmount    Decimal   @default(0.00)
  receivedAmount     Decimal   @default(0.00)
  status             String    @default("PLANNED") // PLANNED, COMMITTED, RECEIVED, ALLOCATED, USED, CANCELLED
  notes              String?

  linkedAccountId    String?
  linkedBorrowingId  String?
  linkedInvestmentId String?
  linkedAssetId      String?
  linkedGoalId       String?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([householdId])
  @@index([sourceType])
}

model ProjectPaymentAllocation {
  id                   String                    @id @default(uuid())
  paymentRequirementId String
  transactionId        String
  householdId          String
  allocatedAmount      Decimal                   @default(0.00)
  notes                String?
  createdAt            DateTime                  @default(now())

  paymentRequirement   ProjectPaymentRequirement @relation(fields: [paymentRequirementId], references: [id], onDelete: Cascade)
  transaction          Transaction               @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([paymentRequirementId])
  @@index([transactionId])
  @@index([householdId])
}

model ProjectTask {
  id               String        @id @default(uuid())
  projectId        String
  householdId      String
  title            String
  description      String?
  status           String        @default("TODO") // TODO, IN_PROGRESS, BLOCKED, COMPLETED, CANCELLED
  priority         String        @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  assignedMemberId String?
  startDate        DateTime?
  dueDate          DateTime?
  parentTaskId     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  project          Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentTask       ProjectTask?  @relation("SubTasks", fields: [parentTaskId], references: [id], onDelete: SetNull)
  subTasks         ProjectTask[] @relation("SubTasks")

  @@index([projectId])
  @@index([householdId])
  @@index([status])
}

model ProjectMilestone {
  id          String    @id @default(uuid())
  projectId   String
  householdId String
  title       String
  description String?
  targetDate  DateTime?
  achievedAt  DateTime?
  status      String    @default("PLANNED") // PLANNED, IN_PROGRESS, ACHIEVED, CANCELLED
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([householdId])
  @@index([status])
}

model ProjectLifecycleHistory {
  id          String   @id @default(uuid())
  projectId   String
  householdId String
  fromStatus  String
  toStatus    String
  action      String   // CREATE, PLAN, ACTIVATE, HOLD, RESUME, COMPLETE, CANCEL, ARCHIVE
  reason      String?
  performedBy String?
  metadata    String?
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([householdId])
}

