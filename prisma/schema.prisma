datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String            @id @default(uuid())
  email          String            @unique
  passwordHash   String
  name           String
  avatarUrl      String?
  isOnboarded    Boolean           @default(false)
  onboardingStep Int               @default(1)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  memberships    HouseholdMember[]
  transactions   Transaction[]
  accounts       Account[]
  employments    EmploymentProfile[]
  payslips       PayslipRecord[]
}

model Household {
  id                    String                 @id @default(uuid())
  name                  String
  currency              String                 @default("INR")
  financialYearStart    String                 @default("APRIL")
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  members               HouseholdMember[]
  accounts              Account[]
  categories            Category[]
  transactions          Transaction[]
  recurringTransactions RecurringTransaction[]
  budgets               Budget[]
  goals                 Goal[]
  investments           Investment[]
  assets                Asset[]
  liabilities           Liability[]
  forecastScenarios     ForecastScenario[]
  forecastSnapshots     ForecastSnapshot[]
  incomeSources         IncomeSource[]
  incomeOccurrences     IncomeOccurrence[]
  recurringOccurrences  RecurringBillOccurrence[]
  invitations           HouseholdInvitation[]
  employments           EmploymentProfile[]
  payslips              PayslipRecord[]
  automationRules       AutomationRule[]
  automationLogs        AutomationExecutionLog[]
  journals              Journal[]
  auditEvents           AuditEvent[]
  alertEvents           AlertEvent[]
  assetFinancialEvents  AssetFinancialEvent[]
  liabilityFinancialEvents LiabilityFinancialEvent[]
  investmentFinancialEvents InvestmentFinancialEvent[]
  financialScopes       FinancialScope[]
  subcategories         CategorySubcategory[]
  costCenters           CostCenter[]
  lenders               Lender[]
  borrowings            Borrowing[]
  repaymentSchedules    RepaymentSchedule[]
  repaymentInstallments RepaymentInstallment[]
  borrowingFinancialEvents BorrowingFinancialEvent[]
  goalFundingPlans      GoalFundingPlan[]
  fundingAssumptionSets FundingAssumptionSet[]
  projects              Project[]
  profiles              FamilyProfile[]
}

model HouseholdMember {
  id          String    @id @default(uuid())
  householdId String
  userId      String
  role        String    @default("MEMBER") // OWNER, MEMBER, VIEWER
  createdAt   DateTime  @default(now())
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
}

model FamilyProfile {
  id           String        @id @default(uuid())
  householdId  String
  name         String
  relationship String        @default("OTHER") // SELF, SPOUSE, PARENT, CHILD, BROTHER, SISTER, GRANDPARENT, GRANDCHILD, RELATIVE, OTHER
  avatarUrl    String?
  color        String?       @default("#6366f1")
  dateOfBirth  DateTime?
  notes        String?
  isPrimary    Boolean       @default(false)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  accounts     Account[]
  transactions Transaction[]
  goals        Goal[]
  assets       Asset[]
  investments  Investment[]
  borrowings   Borrowing[]
  projects     Project[]

  @@unique([householdId, name])
  @@index([householdId])
}

model FinancialInstitution {
  id         String    @id @default(uuid())
  name       String    @unique
  shortCode  String?
  logoUrl    String?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  accounts   Account[]
}

model FinancialScope {
  id               String          @id @default(uuid())
  householdId      String
  name             String
  icon             String          @default("layers")
  color            String          @default("#64748b")
  sortOrder        Int             @default(0)
  isSystem         Boolean         @default(false)
  isActive         Boolean         @default(true)
  externalSystem   String?
  externalEntityId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  household        Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  scopeCategories  ScopeCategory[]
  transactions     Transaction[]
  incomeSources    IncomeSource[]
  assets           Asset[]
  investments      Investment[]
  liabilities      Liability[]
  costCenters      CostCenter[]
  goals            Goal[]
  budgets          Budget[]
  borrowings       Borrowing[]

  @@unique([householdId, name])
}

model ScopeCategory {
  id         String         @id @default(uuid())
  scopeId    String
  categoryId String
  createdAt  DateTime       @default(now())

  scope    FinancialScope @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  category Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([scopeId, categoryId])
}

model CategorySubcategory {
  id          String   @id @default(uuid())
  categoryId  String
  householdId String
  name        String
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  household    Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
  borrowings   Borrowing[]

  @@unique([householdId, categoryId, name])
}

model CostCenter {
  id               String          @id @default(uuid())
  householdId      String
  scopeId          String
  name             String
  type             String?
  description      String?
  icon             String?
  color            String?
  sortOrder        Int             @default(0)
  isSystem         Boolean         @default(false)
  isActive         Boolean         @default(true)
  externalSystem   String?
  externalEntityId String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  household        Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  scope            FinancialScope  @relation(fields: [scopeId], references: [id], onDelete: Cascade)
  transactions     Transaction[]
  assets           Asset[]
  liabilities      Liability[]
  budgets          Budget[]
  borrowings       Borrowing[]

  @@unique([householdId, scopeId, name])
}

model Account {
  id                     String                @id @default(uuid())
  householdId            String
  userId                 String?
  financialInstitutionId String?
  name                   String
  type                   String                @default("BANK") // BANK, CREDIT, CASH, INVESTMENT, LOAN
  balance                Decimal               @default(0.00)
  accountNumber          String?
  currency               String                @default("INR")
  isShared               Boolean               @default(true)
  logoMode               String                @default("AUTO") // AUTO, CUSTOM, ICON, INITIAL
  customLogoUrl          String?
  iconName               String?
  creditLimit            Decimal?
  billingCycleDay        Int?
  paymentDueDate         Int?
  interestRate           Decimal?
  maturityDate           DateTime?
  principalAmount        Decimal?
  isArchived             Boolean               @default(false)
  profileId              String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt

  household            Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userHolder           User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  profile              FamilyProfile?        @relation(fields: [profileId], references: [id], onDelete: SetNull)
  financialInstitution FinancialInstitution? @relation(fields: [financialInstitutionId], references: [id], onDelete: SetNull)
  transactions         Transaction[]         @relation("AccountTransactions")
  transfersIn          Transaction[]         @relation("TransferAccountTransactions")
  recurring            RecurringTransaction[]
  investments          Investment[]          @relation("InvestmentAccountRef")
  incomeSources        IncomeSource[]
  payslips             PayslipRecord[]
  goals                Goal[]
  assets               Asset[]               @relation("AssetAccountRef")
  liabilities          Liability[]           @relation("LiabilityAccountRef")
  borrowingsReceiving  Borrowing[]           @relation("BorrowingReceivingAccount")
  borrowingsLiability  Borrowing[]           @relation("BorrowingLiabilityAccount")
  journalEntries       JournalEntry[]
}

model Category {
  id            String        @id @default(uuid())
  householdId   String
  parentId      String?
  name          String
  icon          String        @default("tag")
  color         String        @default("#64748b")
  type          String        @default("EXPENSE") // INCOME, EXPENSE, TRANSFER
  isDefault     Boolean       @default(false)
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  household     Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  parent        Category?     @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  subcategories       Category[]            @relation("CategoryHierarchy")
  transactions        Transaction[]
  recurring           RecurringTransaction[]
  budgets             Budget[]
  incomeSources       IncomeSource[]
  scopeCategories     ScopeCategory[]
  subcategoriesMaster CategorySubcategory[]
  borrowings          Borrowing[]
  projectCostItems    ProjectCostItem[]
}

model Transaction {
  id                String    @id @default(uuid())
  householdId       String
  accountId         String
  categoryId        String?
  scopeId           String?
  subcategoryId     String?
  costCenterId      String?
  userId            String?
  profileId         String?
  date              DateTime  @default(now())
  amount            Decimal
  type              String    @default("EXPENSE") // INCOME, EXPENSE, TRANSFER
  transferAccountId String?
  incomeSourceId        String?
  occurrenceId          String?
  paymentMethod         String?
  referenceNo           String?
  idempotencyKey       String?   @unique
  isVoided             Boolean   @default(false)
  voidedAt             DateTime?
  voidedByUserId       String?
  refundedAmount       Decimal   @default(0.00)
  refundOfId           String?
  merchant              String?
  receiptUrl            String?
  splitsJson            String?
  reimbursementStatus   String?   @default("NONE") // NONE, CLAIMED, SETTLED
  reimbursedAmount      Decimal   @default(0.00)
  recurringRuleId       String?
  recurringOccurrenceId String?
  isRecurring           Boolean   @default(false)
  description           String
  notes                 String?
  tags                  String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  household           Household                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account             Account                  @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  transferAccount     Account?                 @relation("TransferAccountTransactions", fields: [transferAccountId], references: [id], onDelete: SetNull)
  category            Category?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  scope               FinancialScope?          @relation(fields: [scopeId], references: [id], onDelete: SetNull)
  subcategory         CategorySubcategory?     @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  costCenter          CostCenter?              @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  user                User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  profile             FamilyProfile?           @relation(fields: [profileId], references: [id], onDelete: SetNull)
  incomeSource        IncomeSource?            @relation(fields: [incomeSourceId], references: [id], onDelete: SetNull)
  occurrence          IncomeOccurrence?        @relation(fields: [occurrenceId], references: [id], onDelete: SetNull)
  recurringRule       RecurringTransaction?    @relation(fields: [recurringRuleId], references: [id], onDelete: SetNull)
  recurringOccurrence RecurringBillOccurrence? @relation(fields: [recurringOccurrenceId], references: [id], onDelete: SetNull)
  payslips            PayslipRecord[]
  refundOf            Transaction?              @relation("TransactionRefunds", fields: [refundOfId], references: [id], onDelete: SetNull)
  refunds             Transaction[]             @relation("TransactionRefunds")
  projectAllocations  ProjectPaymentAllocation[]

  status                String    @default("POSTED") // DRAFT, POSTED, RECONCILED, REVERSED, ARCHIVED
  postedAt              DateTime?
  reconciledAt          DateTime?
  reversedAt            DateTime?
  archivedAt            DateTime?
  archivedByUserId      String?
  replacementTransactionId String? @unique
  replacementTransaction   Transaction? @relation("TransactionReplacement", fields: [replacementTransactionId], references: [id], onDelete: SetNull)
  replacedBy               Transaction? @relation("TransactionReplacement")
  lifecycleHistory         TransactionLifecycleHistory[]

  journalId            String?   @unique
  journal              Journal?  @relation(fields: [journalId], references: [id], onDelete: SetNull)

  @@index([refundOfId])
  @@index([householdId, status, date])
  @@index([householdId, accountId, date])
  @@index([householdId, categoryId, date])
}

model RecurringTransaction {
  id          String    @id @default(uuid())
  householdId String
  accountId   String
  categoryId  String?
  name        String
  amount      Decimal
  type        String    @default("EXPENSE") // EXPENSE, INCOME, TRANSFER
  frequency   String    @default("MONTHLY") // DAILY, WEEKLY, MONTHLY, YEARLY
  startDate   DateTime  @default(now())
  endDate     DateTime?
  nextDueDate DateTime  @default(now())
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  household   Household                 @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account     Account                   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  category    Category?                 @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  occurrences RecurringBillOccurrence[]
  transactions Transaction[]
}

model Budget {
  id            String    @id @default(uuid())
  householdId   String
  name          String?
  periodType    String    @default("MONTHLY") // MONTHLY, QUARTERLY, HALF_YEARLY, YEARLY, CUSTOM
  startDate     DateTime  @default(now())
  endDate       DateTime  @default(now())
  month         Int?
  year          Int?
  amount        Decimal
  status        String    @default("ACTIVE") // DRAFT, ACTIVE, PAUSED, COMPLETED, ARCHIVED
  notes         String?
  categoryId    String?
  scopeId       String?
  subcategoryId String?
  costCenterId  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  household   Household            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  category    Category?            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  scope       FinancialScope?      @relation(fields: [scopeId], references: [id], onDelete: SetNull)
  subcategory CategorySubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  costCenter  CostCenter?          @relation(fields: [costCenterId], references: [id], onDelete: SetNull)

  @@index([householdId, status, startDate, endDate])
  @@index([householdId, categoryId])
  @@index([householdId, scopeId])
}

model Goal {
  id               String   @id @default(uuid())
  householdId      String
  accountId        String?
  scopeId          String?
  name             String
  description      String?
  targetAmount     Decimal
  currentAmount    Decimal  @default(0.00)
  targetDate       DateTime
  category         String?
  priority         String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  deadlineFlexibility String @default("MODERATE") // STRICT, MODERATE, FLEXIBLE
  status           String   @default("ACTIVE") // ACTIVE, PAUSED, COMPLETED, ARCHIVED
  notes            String?
  monthlyContribution Decimal? @default(0.00)
  archivedAt       DateTime?
  archivedByUserId String?
  profileId        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  household        Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account          Account?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
  profile          FamilyProfile?  @relation(fields: [profileId], references: [id], onDelete: SetNull)
  scope            FinancialScope? @relation(fields: [scopeId], references: [id], onDelete: SetNull)
  lifecycleHistory GoalLifecycleHistory[]
  fundingPlans     GoalFundingPlan[]
  projects         Project[]
}

model Investment {
  id                   String                      @id @default(uuid())
  householdId          String
  scopeId              String?
  name                 String
  category             String                      @default("MUTUAL_FUND") // STOCK, MUTUAL_FUND, BOND, FIXED_DEPOSIT, GOLD, RETIREMENT, OTHER
  type                 String                      @default("MUTUAL_FUND") // Legacy type field
  symbol               String?
  currency             String                      @default("INR")
  status               String                      @default("DRAFT") // DRAFT, ACTIVE, PARTIALLY_SOLD, CLOSED, ARCHIVED
  description          String?
  totalQuantity        Decimal                     @default(0.00000000)
  totalCostBasis       Decimal                     @default(0.00)
  weightedAverageCost  Decimal                     @default(0.00)
  currentPricePerUnit  Decimal                     @default(0.00)
  currentMarketValue   Decimal                     @default(0.00)
  realizedGainLoss     Decimal                     @default(0.00)
  notes                String?
  investmentAccountId  String?
  closedAt             DateTime?
  archivedAt           DateTime?
  archivedByUserId     String?
  profileId            String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  household            Household                   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  profile              FamilyProfile?              @relation(fields: [profileId], references: [id], onDelete: SetNull)
  scope                FinancialScope?             @relation(fields: [scopeId], references: [id], onDelete: SetNull)
  investmentAccount    Account?                    @relation("InvestmentAccountRef", fields: [investmentAccountId], references: [id], onDelete: SetNull)
  lots                 InvestmentLot[]
  financialEvents      InvestmentFinancialEvent[]
  lifecycleHistory     InvestmentLifecycleHistory[]
  activities           InvestmentActivity[]
}

model InvestmentLot {
  id                String     @id @default(uuid())
  investmentId      String
  householdId       String
  quantity          Decimal    @default(0.00000000)
  remainingQuantity Decimal    @default(0.00000000)
  costPerUnit       Decimal    @default(0.00)
  totalCost         Decimal    @default(0.00)
  purchaseDate      DateTime   @default(now())
  createdAt         DateTime   @default(now())

  investment        Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([investmentId])
}

model InvestmentFinancialEvent {
  id                String      @id @default(uuid())
  investmentId      String
  householdId       String
  eventType         String      // BUY, SELL, DIVIDEND, INTEREST, FEE, REVALUATION, REVERSAL
  quantity          Decimal?    @default(0.00000000)
  pricePerUnit      Decimal?    @default(0.00)
  amount            Decimal     @default(0.00)
  costBasis         Decimal?    @default(0.00)
  gainOrLoss        Decimal?    @default(0.00)
  journalId         String?
  reversalOfEventId String?     @unique
  isReversed        Boolean     @default(false)
  effectiveDate     DateTime    @default(now())
  reason            String?
  idempotencyKey    String?     @unique
  createdByUserId   String?
  createdAt         DateTime    @default(now())

  investment        Investment  @relation(fields: [investmentId], references: [id], onDelete: Cascade)
  household         Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  journal           Journal?    @relation(fields: [journalId], references: [id], onDelete: SetNull)

  reversalOf        InvestmentFinancialEvent?  @relation("InvestmentEventReversals", fields: [reversalOfEventId], references: [id], onDelete: SetNull)
  reversals         InvestmentFinancialEvent[] @relation("InvestmentEventReversals")

  @@index([investmentId, effectiveDate])
  @@index([householdId, effectiveDate])
}

model InvestmentLifecycleHistory {
  id           String     @id @default(uuid())
  investmentId String
  fromStatus   String
  toStatus     String
  action       String
  reason       String?
  performedBy  String?
  createdAt    DateTime   @default(now())

  investment   Investment @relation(fields: [investmentId], references: [id], onDelete: Cascade)

  @@index([investmentId])
}

model Asset {
  id                   String                @id @default(uuid())
  householdId          String
  scopeId              String?
  costCenterId         String?
  name                 String
  category             String                @default("OTHER") // PROPERTY, LAND, VEHICLE, EQUIPMENT, GOLD, LIVESTOCK, OTHER
  type                 String                @default("OTHER")
  status               String                @default("DRAFT") // DRAFT, ACTIVE, DISPOSED, ARCHIVED
  fundingEligibility   String                @default("OPTIONAL") // NOT_ELIGIBLE, OPTIONAL, ELIGIBLE
  description          String?
  initialValue         Decimal               @default(0.00)
  currentValue         Decimal               @default(0.00)
  value                Decimal               @default(0.00)
  purchaseDate         DateTime?
  acquisitionDate      DateTime?
  disposedAt           DateTime?
  disposalProceeds     Decimal?
  notes                String?
  assetAccountId       String?
  acquisitionJournalId String?
  archivedAt           DateTime?
  archivedByUserId     String?
  profileId            String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  household            Household             @relation(fields: [householdId], references: [id], onDelete: Cascade)
  profile              FamilyProfile?        @relation(fields: [profileId], references: [id], onDelete: SetNull)
  scope                FinancialScope?       @relation(fields: [scopeId], references: [id], onDelete: SetNull)
  costCenter           CostCenter?           @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  assetAccount         Account?              @relation("AssetAccountRef", fields: [assetAccountId], references: [id], onDelete: SetNull)
  acquisitionJournal   Journal?              @relation("AssetAcquisitionJournal", fields: [acquisitionJournalId], references: [id], onDelete: SetNull)
  valuations           AssetValuation[]
  financialEvents      AssetFinancialEvent[]
  lifecycleHistory     AssetLifecycleHistory[]
  borrowings           Borrowing[]
}

model AssetFinancialEvent {
  id              String   @id @default(uuid())
  assetId         String
  householdId     String
  eventType       String   // ACQUISITION, REVALUATION, IMPROVEMENT, DEPRECIATION, DISPOSAL
  amount          Decimal  @default(0.00)
  gainOrLoss      Decimal? @default(0.00)
  journalId       String?
  effectiveDate   DateTime @default(now())
  reason          String?
  createdByUserId String?
  createdAt       DateTime @default(now())

  asset     Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  household Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  journal   Journal?  @relation(fields: [journalId], references: [id], onDelete: SetNull)

  @@index([assetId, effectiveDate])
  @@index([householdId, effectiveDate])
}

model AssetLifecycleHistory {
  id          String   @id @default(uuid())
  assetId     String
  fromStatus  String
  toStatus    String
  action      String
  reason      String?
  performedBy String?
  createdAt   DateTime @default(now())

  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model Liability {
  id                   String                      @id @default(uuid())
  householdId          String
  scopeId              String?
  costCenterId         String?
  name                 String
  category             String                      @default("OTHER") // LOAN, MORTGAGE, CREDIT_CARD, PERSONAL_DEBT, PAYABLE, OTHER
  type                 String                      @default("OTHER") // MORTGAGE, PERSONAL_LOAN, CAR_LOAN, EDUCATION_LOAN, CREDIT_CARD_DEBT, OTHER
  status               String                      @default("DRAFT") // DRAFT, ACTIVE, PARTIALLY_SETTLED, SETTLED, ARCHIVED
  description          String?
  principalAmount      Decimal                     @default(0.00)
  outstandingAmount    Decimal                     @default(0.00)
  interestRate         Decimal                     @default(0.00)
  startDate            DateTime?
  dueDate              DateTime?
  lender               String?
  notes                String?
  liabilityAccountId   String?
  borrowJournalId      String?
  archivedAt           DateTime?
  archivedByUserId     String?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt

  household            Household                   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  scope                FinancialScope?             @relation(fields: [scopeId], references: [id], onDelete: SetNull)
  costCenter           CostCenter?                 @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  liabilityAccount     Account?                    @relation("LiabilityAccountRef", fields: [liabilityAccountId], references: [id], onDelete: SetNull)
  borrowJournal        Journal?                    @relation("LiabilityBorrowJournal", fields: [borrowJournalId], references: [id], onDelete: SetNull)
  financialEvents      LiabilityFinancialEvent[]
  lifecycleHistory     LiabilityLifecycleHistory[]
  borrowing            Borrowing?
}

model LiabilityFinancialEvent {
  id              String    @id @default(uuid())
  liabilityId     String
  householdId     String
  eventType       String    // BORROW, INTEREST_ACCRUED, INTEREST_PAID, REPAYMENT, SETTLEMENT
  principalAmount Decimal   @default(0.00)
  interestAmount  Decimal   @default(0.00)
  totalAmount     Decimal   @default(0.00)
  journalId       String?
  effectiveDate   DateTime  @default(now())
  reason          String?
  idempotencyKey  String?   @unique
  createdByUserId String?
  createdAt       DateTime  @default(now())

  liability       Liability @relation(fields: [liabilityId], references: [id], onDelete: Cascade)
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  journal         Journal?  @relation(fields: [journalId], references: [id], onDelete: SetNull)

  @@index([liabilityId, effectiveDate])
  @@index([householdId, effectiveDate])
}

model LiabilityLifecycleHistory {
